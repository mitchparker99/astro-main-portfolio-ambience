---
import Projectlist from "../../components/Projectlist";
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="Mitchell Parker — Projects"
  description="Seven platforms designed, built and operated end-to-end between 2022 and 2026 — commerce architecture, business intelligence, automation, enterprise integration and production AI."
>
  <main
    class="relative flex flex-col text-left py-4 px-5 md:px-20 min-h-screen max-w-6xl"
  >
    <div class="max-w-4xl z-40">
      <header
        class="header-container flex flex-col justify-center overflow-hidden mt-20 lg:mt-56"
      >
        <h1 class="text-white text-5xl font-bold whitespace-nowrap">
          Projects
        </h1>
        <h6 class="text-neutral-500 mt-2 max-w-2xl">
          Platforms designed, built and operated sequentially — each chosen to
          add a capability: commerce architecture, then BI, then automation,
          then enterprise integration, then production AI.
        </h6>
      </header>
      <div class="flex flex-col gap-4 mt-6 mb-12 lg:mb-6 h-full w-full">
        <Projectlist client:load />
      </div>
    </div>
  </main>
</Layout>
