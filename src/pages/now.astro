---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Mitchell Parker — Now"
  description="What Mitchell Parker is working on right now: DiceWill, Mine Market, SAH Studios and the current build slate."
>
  <main
    class="relative flex flex-col text-left py-4 px-5 md:px-20 min-h-screen w-full"
  >
    <div class="max-w-2xl z-40">
      <header
        class="header-container flex flex-col justify-center overflow-hidden mt-20 lg:mt-56"
      >
        <h1 class="text-white text-5xl font-bold">Now</h1>
        <h6 class="text-neutral-500 mb-1">Last updated August 2026</h6>
      </header>

      <div class="overflow-hidden mt-8">
        <h2 class="text-white text-2xl font-bold">Current roles</h2>
        <ul class="text-neutral-400 mt-4 max-w-2xl flex flex-col gap-4">
          <li>
            <span class="text-neutral-100 font-medium"
              >Co-Founder &amp; COO, DiceWill</span
            >
            <span class="text-neutral-500"> · UAE / India</span>
            <p class="mt-1">
              AI health platform — WhatsApp-first triage, records and medication
              management. I own AI &amp; data strategy, governance and
              compliance, plus operations, tooling and partnerships.
            </p>
          </li>
          <li>
            <span class="text-neutral-100 font-medium"
              >Data Architect, Mine Market</span
            >
            <span class="text-neutral-500"> · Australia</span>
            <p class="mt-1">
              Owning ingestion, warehouse modelling and the BI layer leadership
              makes product and commercial decisions from.
            </p>
          </li>
          <li>
            <span class="text-neutral-100 font-medium"
              >Founder, SAH Studios</span
            >
            <span class="text-neutral-500"> · Japan / Australia</span>
            <p class="mt-1">
              AI-automation agency, 100+ clients across e-commerce, hospitality
              and professional services.
            </p>
          </li>
        </ul>
      </div>

      <div class="overflow-hidden mt-10 mb-24">
        <h2 class="text-white text-2xl font-bold">Currently building</h2>
        <ul class="text-neutral-400 mt-4 max-w-2xl list-disc list-inside">
          <li>
            <span class="text-neutral-100">Parker AI</span> — conversational
            Japanese tutor chaining real-time speech recognition into LLM
            response generation.
          </li>
          <li>
            <span class="text-neutral-100">Horizon IT</span> — integration layer
            unifying POS, workforce management and bookings for a multi-site
            hospitality client.
          </li>
          <li>
            <span class="text-neutral-100">Orbis</span> — browser-based editor
            for spherical and 360° footage.
          </li>
        </ul>
      </div>
    </div>
  </main>
</Layout>
