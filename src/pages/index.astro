---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Mitchell Parker — Technology Executive"
  description="Technology leader and startup co-founder owning strategy, AI adoption and data architecture end-to-end — Co-Founder & COO of DiceWill, Data Architect at Mine Market, Founder of SAH Studios."
>
  <main
    class="flex flex-col justify-center relative w-full h-screen text-left py-4 px-5 md:px-20 my-0 mx-auto overflow-hidden box-border"
  >
    <div class="max-w-2xl z-40 relative">
      <h1
        class="flex flex-col w-fit text-5xl lg:text-8xl mt-0 mb-6 text-slate-50 font-bold uppercase"
      >
        <span class="w-fit">Mitchell</span>
        <span class="w-fit">Parker</span>
      </h1>

      <h2
        class="text-slate-400 font-thin text-base lg:text-4xl overflow-hidden"
      >
        <div>
          Technology Executive · AI & Data Architecture — close enough to the
          build to set the standard
        </div>
        <span>
          <span class="text-red-500 font-normal">Technology Strategy</span>
          <span class="text-red-500 font-normal">
            AI Adoption & Governance</span
          >
          <span></span>
          <span class="text-red-500 font-normal">
            Data & Platform Architecture</span
          >
        </span>
      </h2>
    </div>
  </main>
</Layout>
