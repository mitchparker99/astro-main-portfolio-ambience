---
import Workslist from "../../components/Workslist";
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="Mitchell Parker — Work Experience"
  description="Work and leadership experience: Co-Founder & COO at DiceWill, Data Architect at Mine Market, Founder of SAH Studios, plus healthcare, analytics and defence roles."
>
  <main
    class="relative flex flex-col text-left py-4 px-5 md:px-20 min-h-screen max-w-6xl"
  >
    <div class="max-w-4xl z-40">
      <header
        class="header-container flex flex-col justify-center overflow-hidden mt-20 lg:mt-56"
      >
        <h1 class="text-white text-5xl font-bold whitespace-nowrap">
          Work Experience
        </h1>
        <h6 class="text-neutral-500 mt-2 max-w-2xl">
          Leadership roles first, then the professional history behind them —
          healthcare, analytics, hospitality and defence.
        </h6>
      </header>
      <div class="flex flex-col gap-4 mt-6 mb-12 lg:mb-6 h-full w-full">
        <Workslist client:load />
      </div>
    </div>
  </main>
</Layout>
